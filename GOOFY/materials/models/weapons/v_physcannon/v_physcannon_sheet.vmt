"VertexLitGeneric"
{
	"$baseTexture" "Models/Weapons/V_physcannon/v_physcannon_sheet"
	// "$envmap" "env_cubemap"
	// "$envmapmask" "Models/Weapons/V_physcannon/v_physcannon_mask"
	// "$envmapcontrast" ".7"
	// "$envmapsaturation" "[.8 .8 .8]"
	
	$detail Models/Weapons/V_physcannon/v_physcannon_detail
	$detailscale 1
	$detailblendfactor 1
	$detailblendmode 0
	
	"$bumpmap" "models/weapons/v_physcannon/v_physcannon_normal"
	
	"$phong" "1"
	"$phongtint" "[1 1 1]"
	"$phongboost" "5"
	"$phongexponent" "10"
	"$phongfresnelranges" "[10 0.6 1]"
	
	"$rimlight" "0"
	
	"$selfillum" "1"
	
	Proxies
}