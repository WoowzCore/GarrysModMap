"Refract"
{
	$refracttint "[0.8 0.73 0.18]"
	"$bluramount" "1"
	"$ignorez" "1"

	"$bumpmap" "nature/water_coast01_dudv"
	"$normalmap" "woowz_map/gm_garrymod_map_by_woowz_map_garry_game/water_silent_normal"

	$angle "0"
	$translate "[0 0]"
	$center "[0.5 0.5]"
	$scale "[3 3]"
	
	"$bumpframe" "0"
	"Proxies"
	{
		LinearRamp
        {
            "rate" "10"
            "initialValue" "0"
            "resultVar" "$angle"
        }
		"TextureTransform"
		{
			"translateVar" "$translate"
            "rotateVar" "$angle"
            "centerVar" "$center"
            "scaleVar" "$scale"
            "resultVar" "$bumptransform"
		}
	}
}
